{
  "server": {
    "id": "BZSS_Main",
    "name": "BZSS Main Server"
  },

  "udp": {
    "host": "127.0.0.1",
    "port": 6666,
    "maxMessageBytes": 65535
  },

  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 7799,
    "staticDirectory": "./web-client/dist",
    "useVueClient": true,
    "title": "BZSS Panel"
  },

  "pythonLogParser": {
    "enabled": true,
    "pythonExecutable": "python",
    "workingDirectory": "./LogPost  ",
    "scriptPath": "./main.py",
    "configPath": "./config.json",
    "autoStart": true,
    "restartOnExit": false,
    "pipeOutput": true
  },

  "rcon": {
    "enabled": true,
    "host": "192.168.0.184",
    "port": 30144,
    "password": "9290dd2aa02b",
    "rateLimit": {
      "minIntervalMs": 500,
      "maxQueueSize": 100
    }
  },

  "core": {
    "logger": {
      "useColor": true
    }
  },
  "serverTickRate": {
    "expected": 30,
    "warningBelow": 28,
    "criticalBelow": 20,
    "staleAfterSeconds": 10
  },

  "database": {
    "dir": "./data",
    "filename": "micepanel.db"
  },

  "modules": {
    "pluginSubscriptions": { "enabled": true },
    "audit": { "enabled": true },
    "playerState": { "enabled": true },
    "squadState": { "enabled": true },
    "squadCreationOrder": {
      "enabled": false,
      "missingConfirmSnapshots": 2,
      "missingConfirmMs": 15000
    },
    "matchState": { "enabled": true },
    "console": { "enabled": true, "maxLines": 500 },
    "combatState": { "enabled": true, "maxEvents": 5000 },
    "playerDatabase": { "enabled": true },
    "killManage": { "enabled": true },
    "combatClean": { "enabled": true, "maxEvents": 5000 },
    "teamBalance": { "enabled": true },
    "squadManage": { "enabled": true },
    "warning": { "enabled": true },
    "playtime": { "enabled": true },
    "seed": { "enabled": true },
    "points": { "enabled": true }
  },

  "webModules": {
    "required": [
      "web.matchStatus",
      "web.console",
      "web.playerDatabase"
    ],
    "optional": {
      "web.squadManage": true,
      "web.squadCreationOrder": false,
      "web.killManage": true,
      "web.combatClean": true,
      "web.teamBalance": false,
      "web.seed": false,
      "web.points": false
    }
  },

  "plugins": {
    "enabled": true,
    "paths": [
      "./plugins/weapon-collector.js",
      "./plugins/udp-combat-log-forwarder.js"
    ],
    "udpCombatLogForwarder": {
      "enabled": true,
      "host": "114.66.18.134",
      "port": 4000,
      "family": "udp4",
      "maxMessageBytes": 8192,
      "includeRawEvent": false,
      "includeNormalized": true,
      "includeParams": false
    }
  }
}
