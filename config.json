{
  "server": {
    "id": "BZSS_Main",
    "name": "BZSS Main Server"
  },

  "udp": {
    "host": "127.0.0.1",
    "port": 6666,
    "maxMessageBytes": 65535
  },

  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 7799,
    "staticDirectory": "./web-client/dist",
    "useVueClient": true,
    "title": "BZSS Panel"
  },

  "settingsEditor": {
    "enabled": true,
    "exposed": [
      {
        "path": "server.name",
        "label": "Server Name",
        "type": "string",
        "restartRequired": true
      },
      {
        "path": "web.title",
        "label": "Panel Title",
        "type": "string",
        "restartRequired": true
      },
      {
        "path": "web.host",
        "label": "Web Host",
        "type": "string",
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "web.port",
        "label": "Web Port",
        "type": "number",
        "min": 1,
        "max": 65535,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "web.useVueClient",
        "label": "Use Vue Client",
        "type": "boolean",
        "restartRequired": true
      },
      {
        "path": "rcon.enabled",
        "label": "RCON Enabled",
        "type": "boolean",
        "restartRequired": true
      },
      {
        "path": "rcon.host",
        "label": "RCON Host",
        "type": "string",
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "rcon.port",
        "label": "RCON Port",
        "type": "number",
        "min": 1,
        "max": 65535,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "ipLookup.enabled",
        "label": "IP Lookup Enabled",
        "type": "boolean",
        "restartRequired": true
      },
      {
        "path": "ipLookup.provider",
        "label": "IP Lookup Provider",
        "type": "select",
        "options": [
          { "label": "None", "value": "none" },
          { "label": "Manual", "value": "manual" },
          { "label": "Local MMDB", "value": "local-mmdb" },
          { "label": "IP-API", "value": "ip-api" },
          { "label": "IPinfo", "value": "ipinfo" }
        ],
        "restartRequired": true
      },
      {
        "path": "playerIdentityDisplay.showIpInList",
        "label": "Show IP in List",
        "type": "boolean",
        "restartRequired": true
      },
      {
        "path": "playerIdentityDisplay.showIpInDetail",
        "label": "Show IP in Detail",
        "type": "boolean",
        "restartRequired": true
      },
      {
        "path": "serverTickRate.expected",
        "label": "Tick Rate Expected",
        "type": "number",
        "min": 1,
        "max": 120,
        "restartRequired": true
      },
      {
        "path": "serverTickRate.warningBelow",
        "label": "Tick Rate Warning",
        "type": "number",
        "min": 1,
        "max": 120,
        "restartRequired": true
      },
      {
        "path": "serverTickRate.criticalBelow",
        "label": "Tick Rate Critical",
        "type": "number",
        "min": 1,
        "max": 120,
        "restartRequired": true
      },
      {
        "path": "serverTickRate.staleAfterSeconds",
        "label": "Tick Rate Stale After",
        "type": "number",
        "min": 1,
        "max": 600,
        "restartRequired": true
      }
    ]
  },

  "pythonLogParser": {
    "enabled": true,
    "pythonExecutable": "python",
    "workingDirectory": "./LogPost",
    "scriptPath": "./main.py",
    "configPath": "./config.json",
    "autoStart": true,
    "restartOnExit": false,
    "pipeOutput": true
  },

  "rcon": {
    "enabled": true,
    "host": "192.168.0.184",
    "port": 30144,
    "password": "9290dd2aa02b",
    "rateLimit": {
      "minIntervalMs": 500,
      "maxQueueSize": 100
    }
  },

  "core": {
    "logger": {
      "useColor": true
    }
  },
  "ipLookup": {
    "enabled": true,
    "provider": "none",
    "cacheTtlHours": 168,
    "requestTimeoutMs": 3000
  },
  "playerIdentityDisplay": {
    "showIpInList": true,
    "showIpInDetail": true,
    "showIpGeo": true
  },
  "serverTickRate": {
    "expected": 30,
    "warningBelow": 28,
    "criticalBelow": 20,
    "staleAfterSeconds": 10
  },

  "database": {
    "dir": "./data",
    "filename": "micepanel.db"
  },

  "modules": {
    "pluginSubscriptions": { "enabled": true },
    "audit": { "enabled": true },
    "playerState": { "enabled": true },
    "squadState": { "enabled": true },
    "matchState": { "enabled": true },
    "console": { "enabled": true, "maxLines": 500 },
    "combatState": { "enabled": true, "maxEvents": 5000 },
    "playerDatabase": { "enabled": true },
    "killManage": { "enabled": true },
    "combatClean": { "enabled": true, "maxEvents": 5000 },
    "playtime": { "enabled": true }
  },

  "webModules": {
    "required": [
      "web.matchStatus",
      "web.console",
      "web.playerDatabase"
    ],
    "optional": {
      "web.killManage": true,
      "web.combatClean": true
    }
  },

  "plugins": {
    "enabled": true,
    "paths": [
      "./plugins/weapon-collector.js",
      "./plugins/udp-combat-log-forwarder.js"
    ],
    "udpCombatLogForwarder": {
      "enabled": true,
      "host": "114.66.18.134",
      "port": 4000,
      "family": "udp4",
      "maxMessageBytes": 8192,
      "includeRawEvent": false,
      "includeNormalized": true,
      "includeParams": false
    }
  }
}
