      "./plugins/squad-creation-broadcast.js",
      "./plugins/periodic-teamwork-warning.js"
    ],
    "squad-creation-broadcast": {
      "enabled": false,
      "delaySeconds": 5,
      "messageTemplate": "[建队播报] 玩家 ${creatorName} 创建了小队: ${squadName} (小队ID: ${squadId})"
    },
    "periodic-teamwork-warning": {
      "enabled": true,
      "minIntervalMinutes": 10,
      "maxIntervalMinutes": 15,
      "message": "听从队长指挥是战术小队的核心，团队合作才能带来最终的共赢。"
    },
    "fairSquadGuard": {
      "enabled": true,
      "directory": "./data/fair-squad-guard",
      "enforcementPlayerThreshold": 50,
      "noSquadCreationSeconds": 20,
      "infantryOnlyUntilSeconds": 50,
      "maxViolationCountBeforeKick": 15,
      "disbandCommandNameSuffix": "",
      "allowedInfantryNamesText": "",
      "allowedInfantryPatternsText": "",
      "broadcastOnApproved": false,
      "broadcastOnViolation": false
    },
    "stepwiseSquadPlaytimeGuard": {
      "enabled": true,
      "directory": "./data/stepwise-squad-playtime-guard",
      "broadcastOnApproved": false,
      "broadcastOnViolation": false,
      "warnOnMissingPlaytime": true,
      "liveLookupWhenMissing": true,
      "maxRecentRecords": 300,
      "rules": {
        "infantry": [
          {
            "startSeconds": 0,
            "endSeconds": 25,
            "minHoursExclusive": 400
          },
          {
            "startSeconds": 25,
            "endSeconds": 40,
            "minHoursExclusive": 200
          }
        ],
        "vehicle": [
          {
            "startSeconds": 0,
            "endSeconds": 60,
            "minHoursExclusive": 800
          },
          {
            "startSeconds": 60,
            "endSeconds": 75,
            "minHoursExclusive": 600
          },
          {
            "startSeconds": 75,
            "endSeconds": 90,
            "minHoursExclusive": 400
          }
        ]
      }
    },
    "udpEventForwarder": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 39001,
      "serverId": "BZSS_Main",
      "statusIntervalMs": 5000,
      "heartbeatIntervalMs": 30000,
      "includeRawLog": false,
      "includeIds": true,
      "sendCombatEvents": true,
      "sendCombatDamage": true,
      "sendMapChanged": true,
      "sendStatus": true,
      "sendHeartbeat": true,
      "maxQueueSize": 1000,
      "dropPolicy": "drop_oldest",
      "maxPacketBytes": 1200,
      "logSuccess": false,
      "logFailure": true
    }
  },
  "performance": {
    "enabled": true,
    "sampleIntervalMs": 10000,
    "logIntervalMs": 60000,
    "maxHistoryPoints": 120,
    "largeJsonBytes": 262144,
    "slowJsonMs": 50
