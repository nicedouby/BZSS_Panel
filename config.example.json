    "showIpInList": true,
    "showIpInDetail": true,
    "showIpGeo": true
  },
  "serverTickRate": {
    "expected": 30,
    "warningBelow": 28,
    "criticalBelow": 20,
    "staleAfterSeconds": 10
  },
  "database": {
    "dir": "./data",
    "filename": "micepanel.db"
  },
  "modules": {
    "networkStats": {
      "enabled": true,
      "localPingIp": "",
      "pingIntervalSeconds": 15,
      "pingTimeoutMs": 1500,
      "historySize": 10,
      "allowPrivateIps": true
