{
  "server": {
    "id": "BZSS_Main",
    "name": "BZSS Main Server"
  },
  "udp": {
    "host": "127.0.0.1",
    "port": 6666,
    "maxMessageBytes": 65535
  },
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 7799,
    "staticDirectory": "./web-client/dist",
    "useVueClient": true,
    "title": "BZSS Panel"
  },
  "settingsEditor": {
    "enabled": true,
    "exposed": [
      {
        "path": "modules.matchState.polling.serverInfoIntervalMs",
        "label": "Server Info Refresh Interval",
        "type": "number",
        "min": 1000,
        "max": 60000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.matchState.polling.playersIntervalMs",
        "label": "Players Refresh Interval",
        "type": "number",
        "min": 1000,
        "max": 60000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.matchState.polling.squadsIntervalMs",
        "label": "Squads Refresh Interval",
        "type": "number",
        "min": 1000,
        "max": 60000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.matchState.polling.currentMapIntervalMs",
        "label": "Current Map Refresh Interval",
        "type": "number",
        "min": 3000,
        "max": 120000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.matchState.polling.nextMapIntervalMs",
        "label": "Next Map Refresh Interval",
        "type": "number",
        "min": 3000,
        "max": 120000,
        "advanced": true,
        "restartRequired": true
      }
    ]
  },
  "pythonLogParser": {
    "enabled": true,
    "pythonExecutable": "python",
    "workingDirectory": "./LogPost",
    "scriptPath": "./main.py",
    "configPath": "./config.json",
    "autoStart": true,
    "restartOnExit": false,
    "pipeOutput": true
  },
  "rcon": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 30144,
    "password": "",
    "passwordFromEnv": "BZSS_RCON_PASSWORD",
    "rateLimit": {
      "minIntervalMs": 500,
      "maxQueueSize": 100
    }
  },
  "core": {
    "logger": {
      "useColor": true
    }
  },
  "ipLookup": {
    "enabled": true,
    "provider": "none",
    "cacheTtlHours": 168,
    "requestTimeoutMs": 3000
  },
  "playerIdentityDisplay": {
    "showIpInList": true,
    "showIpInDetail": true,
    "showIpGeo": true
  },
  "serverTickRate": {
    "expected": 30,
    "warningBelow": 28,
    "criticalBelow": 20,
    "staleAfterSeconds": 10
  },
  "database": {
    "dir": "./data",
    "filename": "micepanel.db"
  },
  "modules": {
    "pluginSubscriptions": { "enabled": true },
    "audit": { "enabled": true },
    "playerState": { "enabled": true },
    "squadState": { "enabled": true },
    "matchState": {
      "enabled": true,
      "polling": {
        "serverInfoIntervalMs": 5000,
        "playersIntervalMs": 3000,
        "squadsIntervalMs": 5000,
        "currentMapIntervalMs": 15000,
        "nextMapIntervalMs": 30000
      }
    },
    "console": { "enabled": true, "maxLines": 500 },
    "combatState": { "enabled": true, "maxEvents": 5000 },
    "playerDatabase": { "enabled": true },
    "killManage": { "enabled": true },
    "combatClean": { "enabled": true, "maxEvents": 5000 },
    "playtime": { "enabled": true }
  },
  "webModules": {
    "required": [
      "web.matchStatus",
      "web.console",
      "web.playerDatabase"
    ],
    "optional": {
      "web.killManage": true,
      "web.combatClean": true
    }
  },
  "plugins": {
    "enabled": true,
    "paths": [
      "./plugins/weapon-collector.js",
      "./plugins/udp-combat-log-forwarder.js"
    ],
    "udpCombatLogForwarder": {
      "enabled": true,
      "host": "114.66.18.134",
      "port": 4000,
      "family": "udp4",
      "maxMessageBytes": 8192,
      "includeRawEvent": false,
      "includeNormalized": true,
      "includeParams": false
    }
  }
}
