      "showKillDisplay": false,
      "showOnlyLightWeaponDamage": true,
      "showVictimDamage": true,
      "showVictimWound": true,
      "showVictimKill": true,
      "showAttackerDamage": true,
      "storeRecentEventLimit": 300,
      "attackerDamageDisplayGate": {
        "enabled": false,
        "mode": "inside_leader_radius",
        "fallbackWhenUnknown": "allow",
        "applyToTypes": ["damage"],
        "onlyLightWeapon": true
      }
    },
    "adminWarn": {
      "enabled": true,
      "maxRecords": 3000,
      "ttlMs": 1800000
    },
    "remoteTelemetry": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 12764,
      "sampleIntervalMs": 2000,
      "timeoutMultiplier": 3,
      "commandHost": "",
      "commandPort": 12765,
      "commandTimeoutMs": 3000,
      "freezeSampleThreshold": 15,
      "recentSampleLimit": 50
    },
    "scheduledBroadcast": {
      "enabled": true,
      "tickMs": 1000,
      "dataFile": "./data/scheduled-broadcast/list.json"
    },
    "playtime": {
      "enabled": true
    }
