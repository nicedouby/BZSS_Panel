{
  "server": {
    "id": "BZSS_Main",
    "name": "BZSS Main Server"
  },
  "warmup": {
    "enabled": false
  },
  "udp": {
    "host": "127.0.0.1",
    "port": 6666,
    "maxMessageBytes": 65535
  },
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 7799,
    "staticDirectory": "./web-client/dist",
    "useVueClient": true,
    "title": "BZSS Panel"
  },
  "auth": {
    "enabled": true,
    "defaultSteam64": "",
    "viewerTeamAutoSwapEnabled": true
  },
  "settingsEditor": {
    "enabled": true,
    "exposed": [
      {
        "path": "modules.matchState.polling.serverInfoIntervalMs",
        "label": "Server Info Refresh Interval",
        "type": "number",
        "min": 100,
        "max": 60000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.matchState.polling.playersIntervalMs",
        "label": "Players Refresh Interval",
        "type": "number",
        "min": 100,
        "max": 60000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.matchState.polling.squadsIntervalMs",
        "label": "Squads Refresh Interval",
        "type": "number",
        "min": 100,
        "max": 60000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.matchState.polling.currentMapIntervalMs",
        "label": "Current Map Refresh Interval",
        "type": "number",
        "min": 3000,
        "max": 120000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.matchState.polling.nextMapIntervalMs",
        "label": "Next Map Refresh Interval",
        "type": "number",
        "min": 3000,
        "max": 120000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.appId",
        "label": "Steam App ID",
        "type": "number",
        "min": 1,
        "max": 2147483647,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.maxConcurrent",
        "label": "Steam Lookup Max Concurrent",
        "type": "number",
        "min": 1,
        "max": 20,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.requestTimeoutMs",
        "label": "Steam Request Timeout",
        "type": "number",
        "min": 100,
        "max": 120000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.defaultWaitMs",
        "label": "Steam Job Wait Timeout",
        "type": "number",
        "min": 0,
        "max": 30000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.retryCount",
        "label": "Steam Retry Count",
        "type": "number",
        "min": 0,
        "max": 5,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.retryDelayMs",
        "label": "Steam Retry Delay",
        "type": "number",
        "min": 100,
        "max": 10000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.usePythonScript",
        "label": "Steam Use Python Script",
        "type": "boolean",
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.scriptTimeoutMs",
        "label": "Steam Script Timeout",
        "type": "number",
        "min": 1000,
        "max": 120000,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.scriptFallbackToApi",
        "label": "Steam Script Fallback To API",
        "type": "boolean",
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "steam.onlineRefreshFreshnessWindowMinutes",
        "label": "Steam Refresh Freshness Window",
        "type": "number",
        "min": 0,
        "max": 10080,
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.combatClean.weaponHistoryBackfill.enabled",
        "label": "CombatClean Weapon History Backfill",
        "type": "boolean",
        "advanced": true,
        "restartRequired": true
      },
      {
        "path": "modules.combatClean.weaponHistoryBackfill.windowMs",
        "label": "CombatClean Weapon History Backfill Window",
        "type": "number",
        "min": 1000,
        "max": 600000,
        "advanced": true,
        "restartRequired": true
      }
    ]
  },
  "pythonLogParser": {
    "enabled": true,
    "pythonExecutable": "python",
    "workingDirectory": "./LogPost",
    "scriptPath": "./main.py",
    "configPath": "./config.json",
    "autoStart": true,
    "restartOnExit": false,
    "pipeOutput": true
  },
  "steam": {
    "appId": 393380,
    "maxConcurrent": 3,
    "requestTimeoutMs": 20000,
    "defaultWaitMs": 15000,
    "retryCount": 2,
    "retryDelayMs": 1200,
    "usePythonScript": true,
    "scriptTimeoutMs": 12000,
    "scriptFallbackToApi": false,
    "onlineRefreshFreshnessWindowMinutes": 120
  },
  "rcon": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 30144,
    "password": "",
    "passwordFromEnv": "BZSS_RCON_PASSWORD",
    "rateLimit": {
      "minIntervalMs": 500,
      "maxQueueSize": 100
    }
  },
  "core": {
    "logger": {
      "useColor": true
    }
  },
  "ipLookup": {
    "enabled": true,
    "provider": "none",
    "cacheTtlHours": 168,
    "requestTimeoutMs": 3000
  },
  "playerIdentityDisplay": {
    "showIpInList": true,
    "showIpInDetail": true,
    "showIpGeo": true
  },
  "serverTickRate": {
    "expected": 30,
    "warningBelow": 28,
    "criticalBelow": 20,
    "staleAfterSeconds": 10
  },
  "database": {
    "dir": "./data",
    "filename": "micepanel.db"
  },
  "modules": {
    "pluginSubscriptions": { "enabled": true },
    "audit": { "enabled": true },
    "playerState": { "enabled": true },
    "squadState": { "enabled": true },
    "squadLifecycle": {
      "enabled": true,
      "rconPollIntervalMs": 1000,
      "rconTimeoutMs": 800,
      "missingConfirmCount": 2,
      "emptySnapshotGuard": true,
      "suspiciousEmptySnapshotPlayerThreshold": 5,
      "createFromRconSnapshot": true,
      "preferLogCreateEvent": true,
      "closeSquadsOnMatchEnd": true,
      "matchChangingGraceMs": 10000,
      "debug": true
    },
    "squadManagement": {
      "enabled": true,
      "disbandPermission": "squad.disband",
      "kickPermission": "squad.kick",
      "kickThreshold": 10,
      "noBuildUntilSeconds": 20,
      "infantryOnlyUntilSeconds": 50,
      "sweepIntervalMs": 15000,
      "allowedInfantryNames": [
        "萌新队",
        "填线队"
      ],
      "defaultSquadNamePattern": "^Squad\\s*\\d+$"
    },
    "matchState": {
      "enabled": true,
      "polling": {
        "serverInfoIntervalMs": 5000,
        "playersIntervalMs": 3000,
        "squadsIntervalMs": 5000,
        "currentMapIntervalMs": 15000,
        "nextMapIntervalMs": 30000
      }
    },
    "console": { "enabled": true, "maxLines": 500 },
    "combatState": { "enabled": true, "maxEvents": 5000 },
    "playerDatabase": { "enabled": true },
    "killManage": { "enabled": true },
    "combatClean": {
      "enabled": true,
      "maxEvents": 5000,
      "weaponHistoryBackfill": {
        "enabled": true,
        "windowMs": 300000
      }
    },
    "adminWarn": {
      "enabled": true,
      "maxRecords": 3000,
      "ttlMs": 1800000
    },
    "playtime": { "enabled": true }
  },
  "webModules": {
    "required": [
      "web.matchStatus",
      "web.console",
      "web.playerDatabase"
    ],
    "optional": {
      "web.killManage": true,
      "web.combatClean": true
    }
  },
  "plugins": {
    "enabled": true,
    "paths": [
      "./plugins/group-report.js",
      "./plugins/weapon-collector.js",
      "./plugins/fair-squad.js",
      "./plugins/server-info-statistics.js",
      "./plugins/udp_event_forwarder.js"
    ],
    "udpEventForwarder": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 39001,
      "serverId": "BZSS_Main",
      "statusIntervalMs": 5000,
      "heartbeatIntervalMs": 30000,
      "includeRawLog": false,
      "includeIds": true,
      "sendCombatEvents": true,
      "sendCombatDamage": true,
      "sendMapChanged": true,
      "sendStatus": true,
      "sendHeartbeat": true,
      "maxQueueSize": 1000,
      "dropPolicy": "drop_oldest",
      "maxPacketBytes": 1200,
      "logSuccess": false,
      "logFailure": true
    }
  }
}
