    },
    "infantryCombatEnhancer": {
      "enabled": true,
      "forceAttackerDamageDisplay": false,
      "minAttackerDamage": 15,
      "damageDebounceMs": 0,
      "damageAggregation": {
        "enabled": false,
        "debounceMs": 0
