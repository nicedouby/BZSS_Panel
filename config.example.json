    "pluginSubscriptions": {
      "enabled": true
    },
    "audit": {
      "enabled": true
    },
    "playerSessionRecords": {
      "enabled": true,
      "maxRecords": 2000
    },
    "playerState": {
      "enabled": true
    },
    "squadLifecycle": {
      "enabled": true,
      "rconPollIntervalMs": 1000,
      "rconTimeoutMs": 800,
      "missingConfirmCount": 2,
      "emptySnapshotGuard": true,
      "suspiciousEmptySnapshotPlayerThreshold": 5,
      "createFromRconSnapshot": true,
      "preferLogCreateEvent": true,
      "closeSquadsOnMatchEnd": true,
      "matchChangingGraceMs": 10000,
      "debug": true
    },
    "squadManagement": {
      "enabled": true,
      "disbandPermission": "squad.disband",
      "kickPermission": "squad.kick",
      "removePermission": "squad.remove",
      "kickThreshold": 10,
      "noBuildUntilSeconds": 20,
      "infantryOnlyUntilSeconds": 50,
      "sweepIntervalMs": 15000,
      "allowedInfantryNames": [
        "萌新队",
        "填线队"
      ],
      "defaultSquadNamePattern": "^Squad\\s*\\d+$"
    },
    "squadNamePolicyGuard": {
      "enabled": true,
      "detectLogCreated": true,
      "action": "disband_then_warn",
      "dedupeTtlMs": 300000,
      "warningRepeatDelayMs": 2000,
      "warningRepeatCount": 2,
      "rconPatrol": {
        "enabled": false,
        "intervalMs": 15000
      }
    },
    "matchState": {
      "enabled": true,
      "polling": {
        "serverInfoIntervalMs": 5000,
        "playersIntervalMs": 3000,
        "squadsIntervalMs": 5000,
        "dynamic": {
          "enabled": true,
          "fastUntilSeconds": 90,
          "mediumUntilSeconds": 180,
          "fastPlayersIntervalMs": 1000,
          "fastSquadsIntervalMs": 1500,
          "mediumPlayersIntervalMs": 2500,
          "mediumSquadsIntervalMs": 3500
        },
        "currentMapIntervalMs": 15000,
        "nextMapIntervalMs": 30000
      }
    },
    "console": {
      "enabled": true,
      "maxLines": 500
    },
    "combatState": {
      "enabled": true,
      "maxEvents": 5000
    },
    "playerDatabase": {
      "enabled": true
    },
    "astrbotBridge": {
      "enabled": true,
      "apiToken": "",
      "trustedIps": [],
      "allowedActions": [
        "bindProfile",
        "setWarmup",
        "toggleWarmup"
      ]
    },
    "playerTimeStats": {
      "enabled": true,
      "tickMs": 10000,
      "maxDeltaSeconds": 60,
      "warmupPointsMultiplier": 1
