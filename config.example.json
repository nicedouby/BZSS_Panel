  "reserveSystem": {
    "enabled": true,
    "adminFilePath": "",
    "localReserveFilePath": "data/reserve-slots/store.json"
  },
  "pythonLogParser": {
    "enabled": true,
    "pythonExecutable": "python",
    "workingDirectory": "./LogPost",
    "scriptPath": "./main.py",
    "configPath": "./config.json",
    "autoStart": true,
    "restartOnExit": false,
    "pipeOutput": true
  },
  "steam": {
    "appId": 393380,
    "maxConcurrent": 3,
    "requestTimeoutMs": 20000,
    "defaultWaitMs": 15000,
    "retryCount": 2,
    "retryDelayMs": 1200,
    "usePythonScript": true,
    "pythonScript": "./support/runtime-assets/steam-playtime/FetchGameDuration.py",
    "pythonConfigPath": "./support/runtime-assets/steam-playtime/config.json",
    "scriptTimeoutMs": 12000,
    "scriptFallbackToApi": false,
    "onlineRefreshFreshnessWindowMinutes": 120
  },
  "rcon": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 30144,
    "password": "",
    "passwordFromEnv": "BZSS_RCON_PASSWORD",
    "allowMultipleConnections": false,
    "commandPoolSize": 4,
    "queryPoolSize": 1,
    "rateLimit": {
      "minIntervalMs": 500,
      "priorityMinIntervalMs": 50,
      "maxQueueSize": 100
    }
  },
  "core": {
    "logger": {
      "useColor": true
    }
  },
  "ipLookup": {
    "enabled": true,
    "provider": "none",
    "cacheTtlHours": 168,
    "requestTimeoutMs": 3000
  },
