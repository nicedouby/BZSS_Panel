{
  "rcon": {
    "enabled": true,
    "host": "192.168.0.183",
    "port": 30144,
    "password": "",
    "passwordFromEnv": "BZSS_RCON_PASSWORD",

    "autoReconnectDelay": 5000,
    "commandTimeoutMs": 15000,
    "connectTimeoutMs": 5000,
    "allowMultipleConnections": true,
    "commandPoolSize": 4,
    "notificationPoolSize": 2,
    "notificationTimeoutMs": 3000,
    "enforcementPoolSize": 1,
    "queryPoolSize": 1,

    "rateLimit": {
      "minIntervalMs": 500,
      "priorityMinIntervalMs": 50,
      "maxQueueSize": 100
    },

    "polling": {
      "enabled": false,
      "playersIntervalMs": 5000,
      "squadsIntervalMs": 10000
    }
  },

  "modules": {
    "matchState": {
      "enabled": true,
      "polling": {
        "serverInfoIntervalMs": 5000,
        "playersIntervalMs": 3000,
        "squadsIntervalMs": 5000,
        "currentMapIntervalMs": 15000,
        "nextMapIntervalMs": 30000
      }
    },

    "console": {
      "enabled": true,
      "maxLines": 5000
    }
  }
}
