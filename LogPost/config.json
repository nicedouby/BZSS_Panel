{
  "server_id": "BZSS_Main",
  "log_file": "W:\\SquadGame\\Saved\\Logs\\SquadGame.log",
  "output_dir": "./LogPost",
  "poll_interval_ms": 200,
  "tail": {
    "from_end": true,
    "reopen_on_truncate": true
  },
  "udp": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 7788,
    "max_payload_bytes": 8192
  },
  "unknown": {
    "write_unknown": false
  },
  "raw": {
    "max_raw_chars": 4096
  },
  "raw_input_log": {
    "enabled": true,
    "output_dir": "./ReceivedLogs",
    "file_name": "Received.log",
    "format": "raw"
  },
  "blacklist_contains": [
    "GetDefaultPawnClassForController_Implementation()",
    "IsSpawnpointAllowed()",
    "FindPlayerStart_Implementation()",
    "SpawnDefaultPawnFor_Implementation()",
    "TraceAndMessageClient()",
    "BeginInactiveState()",
    "EndInactiveState()",
    "ServerFireProjectileWithId_Implementation()",
    "SQVehicle::OnTakeDamage",
    "SQVehicle::TakeDamage",
    "VehicleMovementComponent",
    "LogEOS:",
    "LogHttp:",
    "LogOnline:",
    "LogNet:",
    "LogPakFile:",
    "LogStreaming:"
  ],
  "console": {
    "enabled": true,
    "use_color": true,
    "show_params": true,
    "max_params": 8,
    "max_param_chars": 36,
    "show_log_time": true
  },
  "logpost_web": {
    "host": "127.0.0.1",
    "port": 7790,
    "output_dir": "./LogPost",
    "max_lines_per_request": 2000
  }
}