{
  "server_id": "BZSS_Main",
  "log_file": "Z:\\Users\\Administrator\\Desktop\\bzss_sq_server\\SquadGame\\Saved\\Logs\\SquadGame.log",
  "output_dir": "./LogPost",
  "poll_interval_ms": 50,
  "tail": {
    "from_end": true,
    "reopen_on_truncate": true
  },
  "udp": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 12345,
    "max_payload_bytes": 2048
  },
  "unknown": {
    "write_unknown": false
  },
  "preserve": {
    "enabled": true,
    "write_file": true,
    "file_name": "Preserved.jsonl",
    "contains": [
      "LogNet: Join succeeded:",
      "LogNet: PostLogin: NewPlayer:",
      "LogSquad: PostLogin: NewPlayer:",
      "LogNet: UNetConnection::Close:"
    ]
  },
  "raw": {
    "max_raw_chars": 4096
  },
  "server_tick_rate": {
    "expected": 30,
    "warning_below": 28,
    "critical_below": 20,
    "stale_after_seconds": 10
  },
  "raw_input_log": {
    "enabled": false,
    "output_dir": "./ReceivedLogs",
    "file_name": "Received.log",
    "format": "raw"
  },
  "raw_log_output": {
    "enabled": true,
    "source": "Squad.log",
    "mode": "sampled",
    "max_per_second": 20,
    "only_preserved": false,
    "drop_blacklisted": true,
    "contains": [
      "LogWorld: SeamlessTravel to:",
      "LogSquad: PostLogin:",
      "LogNet: UNetConnection::Close:",
      "LogSquadTrace:",
      "PlayerBaseInfo{",
      "PRI{{",
      "PlayerScoreboard{",
      "CPZ:",
      "FOBI:",
      "MainZone:{",
      "ApplyExplosiveDamage():"
    ]
  },
  "checkpoint": {
    "flush_every_lines": 500,
    "flush_every_ms": 500,
    "force_on_event": true
  },
  "blacklist_contains": [
    "GetDefaultPawnClassForController_Implementation()",
    "IsSpawnpointAllowed()",
    "FindPlayerStart_Implementation()",
    "SpawnDefaultPawnFor_Implementation()",
    "TraceAndMessageClient()",
    "BeginInactiveState()",
    "EndInactiveState()",
    "ServerFireProjectileWithId_Implementation()",
    "SQVehicle::OnTakeDamage",
    "SQVehicle::TakeDamage",
    "VehicleMovementComponent"
  ],
  "console": {
    "enabled": false,
    "use_color": true,
    "show_params": false,
    "max_params": 8,
    "max_param_chars": 36,
    "show_log_time": true
  },
  "logpost_web": {
    "host": "127.0.0.1",
    "port": 12345,
    "output_dir": "./LogPost",
    "max_lines_per_request": 2000
  }
}
